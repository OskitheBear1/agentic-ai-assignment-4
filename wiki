#!/usr/bin/env bash
# Launcher for the personal wiki CLI. Uses the project venv so the exact
# dependency set is always the one documented in requirements.txt.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python="$here/.venv/bin/python"
if [[ ! -x "$python" ]]; then
  echo "error: $python not found. Create the environment first:" >&2
  echo "  python3.12 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec "$python" -c 'import sys; sys.path.insert(0, "'"$here"'"); from wiki_cli.cli import main; sys.exit(main())' "$@"
